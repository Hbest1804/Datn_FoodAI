# VITE_API_URL: Địa chỉ backend. Chạy riêng ở máy thì đặt http://localhost:5000.
# Để trống thì frontend gọi /api cùng origin (khi chạy bằng Docker Compose, Nginx chuyển /api sang backend).
VITE_API_URL="http://localhost:5000"

# VITE_GOOGLE_CLIENT_ID: Client ID OAuth (loại Web application) trong Google Cloud Console.
# Có giá trị thì nút Google chạy trên domain của web, Google hiện "Tiếp tục tới <domain của web>" thay vì xxx.supabase.co.
VITE_GOOGLE_CLIENT_ID=""
