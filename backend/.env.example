# Server
PORT=5000
NODE_ENV=development
# Danh sách origin được phép gọi API (phân tách bằng dấu phẩy)
CORS_ORIGIN=http://localhost:3000

# Supabase (Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role key: CHỈ dùng ở backend, tuyệt đối không đưa lên frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key
# Model chính: gemini-3.8-flash (hỗ trợ failover dự phòng: gemini-3.5-flash-lite, gemini-3.1-flash-lite, gemini-2.5-flash)
GEMINI_MODEL=gemini-3.5-flash-lite
# Model Embedding: gemini-embedding-2 (hỗ trợ MRL 768, 1536, 3072 chiều)
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GUEST_CHAT_LIMIT=5

# Khởi tạo Admin ban đầu khi chạy server
ADMIN_EMAIL=admin@culina.vn
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_ROLE=admin
ADMIN_NAME=Quản Trị Viên

# Gửi mã đặt lại mật khẩu qua máy chủ thư SMTP (liên kết trong email dùng địa chỉ đầu tiên của CORS_ORIGIN).
# Để trống SMTP_HOST khi phát triển: mã được in ra nhật ký máy chủ.
# Gmail: dùng Mật khẩu ứng dụng (App Password), không dùng mật khẩu đăng nhập
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true khi dùng cổng 465 (SSL), false với cổng 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# Tên/địa chỉ người gửi; để trống thì dùng SMTP_USER
SMTP_FROM=
